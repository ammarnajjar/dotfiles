import () {
    [[ -r "$1" ]] && source "$1"
}

export GPG_TTY=$(tty)

shopt -s histappend
export HISTCONTROL=ignoreboth:erasedups
export HISTFILESIZE=9999999999

import "$dotfiles_dir/shell/common.sh"
import "$dotfiles_dir/shell/bash/bash-sensible/sensible.bash"
import "$dotfiles_dir/git/git-completion.bash"
import /etc/bash_completion
import "$HOME/.fzf.bash"

# prompt
function __prompt_command() {
    local venv="" git_branch="" branch
    local yellow='\[\e[0;33m\]'
    local green='\[\e[0;32m\]'
    local purple='\[\e[0;35m\]'
    local gray='\[\e[0;37m\]'
    local reset='\[\e[0m\]'

    if [ -n "$VIRTUAL_ENV" ]; then
        venv="(${purple}$(basename "$VIRTUAL_ENV")${reset}) "
    fi

    branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
    if [ -n "$branch" ]; then
        git_branch=" [${green}${branch}${reset}]"
    fi

    PS1="${venv}${yellow}\w${reset}${git_branch} ${gray}\t${reset}\n\$ "

    history -a
}
PROMPT_COMMAND=__prompt_command

# mise (shims mode: zero startup cost)
eval "$(mise activate bash --shims)"

import "$HOME/.local_bashrc"

# lazy-load kubectl completion on first use
if command -v kubectl &>/dev/null; then
    function kubectl() {
        unset -f kubectl
        source <(command kubectl completion bash)
        command kubectl "$@"
    }
fi

